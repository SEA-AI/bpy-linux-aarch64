# Blender tag `./build.sh` builds when given none. CUDA and OptiX versions come
# from that tag's own build_files/config/pipeline_config.yaml, as on Blender's
# buildbot.
BLENDER_TAG=v5.2.2

# PEP 440 local version appended to the wheel's, marking it as patched.
# Bump it whenever patches/ changes.
LOCAL_VERSION=patch.1

# GPU kernels to compile. Upstream's default list targets x86 desktop GPUs;
# these are the NVIDIA GPUs that ship next to an ARM CPU:
#   sm_87  Jetson Orin       sm_90  Grace Hopper
#   sm_100 Grace Blackwell   sm_120 RTX Blackwell (ARM servers)
#   sm_121 DGX Spark / GB10
# compute_87 is PTX the driver compiles on first use for anything newer
# (Jetson Thor included).
CUDA_ARCHS="sm_87;sm_90;sm_100;sm_120;sm_121;compute_87"
